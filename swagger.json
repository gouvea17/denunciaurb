{
    "openapi": "3.0.0",
    "info": {
      "title": "API de Usuários",
      "version": "1.0.0",
      "description": "API para cadastro, login e geração de hash SHA-256"
    },
    "servers": [
      {
        "url": "http://localhost:3000"
      }
    ],
    "paths": {
      "/hash": {
        "post": {
          "summary": "Gerar hash da senha",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "senha_usuario": {
                      "type": "string",
                      "example": "123456"
                    }
                  },
                  "required": ["senha_usuario"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Hash gerado",
              "content": {
                "text/plain": {
                  "schema": {
                    "type": "string",
                    "example": "8d969eef6ecad3c29a3a629280e686cf..."
                  }
                }
              }
            }
          }
        }
      },
      "/cadastro": {
        "post": {
          "summary": "Cadastrar usuário",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nome_completo": {
                      "type": "string",
                      "example": "João Silva"
                    },
                    "email": {
                      "type": "string",
                      "example": "joao@email.com"
                    },
                    "senha": {
                      "type": "string",
                      "example": "123456"
                    },
                    "caminho_foto": {
                      "type": "string",
                      "example": "/uploads/foto.jpg"
                    }
                  },
                  "required": ["nome_completo", "email", "senha"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Usuário cadastrado",
              "content": {
                "text/plain": {
                  "schema": {
                    "type": "string",
                    "example": "Usuário cadastrado com sucesso"
                  }
                }
              }
            }
          }
        }
      },
      "/login": {
        "post": {
          "summary": "Login do usuário",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string",
                      "example": "joao@email.com"
                    },
                    "senha": {
                      "type": "string",
                      "example": "123456"
                    }
                  },
                  "required": ["email", "senha"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Resultado do login",
              "content": {
                "text/plain": {
                  "schema": {
                    "type": "string",
                    "example": "Login realizado com sucesso"
                  }
                }
              }
            }
          }
        }
      }
    }
  }